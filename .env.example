APP_NAME="Video Aff"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=video_aff
DB_USERNAME=video_aff
DB_PASSWORD=secret

# Tài khoản admin tạo bởi AdminUserSeeder (để trống mật khẩu thì seeder tự sinh)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@video-aff.local
ADMIN_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Video Aff
MEDIA_DISK=public
# Để trống khoá thì dùng Claude bản web (copy prompt sang claude.ai). Không commit khoá thật.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Claude bằng gói Claude Pro/Max (không cần API key): SCRIPT_DRIVER=claude_cli,
# chạy `claude setup-token` trên máy rồi dán token vào đây. CLAUDE_CLI_MODEL: sonnet, opus... (trống = mặc định).
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_CLI_MODEL=

# Muse Image qua fal. Để trống FAL_KEY thì dùng Muse bản web (tạo ảnh trên meta.ai rồi tải lên).
# MUSE_DRIVER=browser: trình duyệt ngầm đăng nhập muse.ai bằng tài khoản của bạn (màn hình Xác thực Muse).
MUSE_DRIVER=
FAL_KEY=
# MiniMax trực tiếp (Hailuo video, image-01): nên nhập ở Quản trị → Kết nối AI (lưu mã hoá). Vùng: global hoặc china.
MINIMAX_API_KEY=
MINIMAX_REGION=global
# Mật khẩu nội bộ giữa app và dịch vụ browser (chuỗi ngẫu nhiên bất kỳ).
MUSE_BROWSER_TOKEN=

# Đăng Reels lên Trang Facebook (developers.facebook.com → app → Cài đặt ứng dụng → Thông tin cơ bản)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Đăng video lên TikTok (developers.tiktok.com → app → Client key / Client secret)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Email liên hệ trên trang /privacy, /terms, /data-deletion
CONTACT_EMAIL=
FFMPEG_BINARY=ffmpeg
# Job ghép video có thể chạy tới 15 phút; phải lớn hơn timeout của job.
DB_QUEUE_RETRY_AFTER=960

# Thư mục dữ liệu ngoài Docker (media, mysql, backups). Mặc định ../video-aff-data
# VIDEO_AFF_DATA=../video-aff-data
